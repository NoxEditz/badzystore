# Supabase Configuration
# The URL of your Supabase project (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=

# The public anon key of your Supabase project
VITE_SUPABASE_PUBLISHABLE_KEY=
# Fallback alias for the publishable key
VITE_SUPABASE_ANON_KEY=

# Analytics Configuration
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Meta/TikTok Pixel IDs (optional)
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# General Configuration
# The domain of the store, used for SEO and Open Graph metadata (e.g. https://badzystore.com)
VITE_STORE_DOMAIN=

# Admin Dashboard
# Password used to log into the /admin panel
ADMIN_PASSKEY=

# Secret used to sign admin session tokens — use any random 32+ character string
ADMIN_SESSION_SECRET=

# Supabase service role key — bypasses RLS, used server-side only for order placement
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
# NEVER commit this to GitHub or expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=
